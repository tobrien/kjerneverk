{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start RiotPlan MCP Server",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder:riotplan}/dist/mcp-server-http.js",
        "--port",
        "3002",
        "--plans-dir",
        "${workspaceFolder:kjerneverk}/plans"
      ],
      "options": {
        "cwd": "${workspaceFolder:riotplan}",
        "env": {}
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting server|listening",
          "endsPattern": "Server listening on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "riotplan"
      }
    }
  ]
}
