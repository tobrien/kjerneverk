{
  "name": "@riotprompt/riotplan-dashboard",
  "version": "0.0.1",
  "description": "Web dashboard for RiotPlan - visualize and manage plans",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "riotplan-dashboard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run lint && tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "start": "node dist/bin.js",
    "test": "npm run test:coverage",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "precommit": "npm run lint && npm run test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "author": "Tim O'Brien <tobrien@discursive.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@riotprompt/riotplan": "file:../riotplan"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "typescript": "^5.8.2",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.1"
  }
}

